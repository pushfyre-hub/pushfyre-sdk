<?xml version="1.0" encoding="utf-8"?>
<!--
  Merged into the consuming app at build time, so an integrator declares nothing:
  the permission and the messaging service arrive with the dependency.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application>
        <service
            android:name="com.wonindia.push.PushFyreMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <!-- Invisible; only routes a notification tap. Android 12+ requires the tap's
             PendingIntent to target an Activity rather than a receiver. -->
        <activity
            android:name="com.wonindia.push.PushFyreTapActivity"
            android:exported="false"
            android:noHistory="true"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />
    </application>
</manifest>
